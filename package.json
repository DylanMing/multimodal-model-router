{
  "name": "dsh-multimodal-model-router",
  "version": "1.3.0",
  "description": "Route image- and file-bearing requests to a chosen multimodal model while every other request stays on the primary model.",
  "license": "MIT",
  "author": "DylanMing",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DylanMing/multimodal-model-router.git"
  },
  "homepage": "https://github.com/DylanMing/multimodal-model-router#readme",
  "bugs": {
    "url": "https://github.com/DylanMing/multimodal-model-router/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "plugin",
    "multimodal",
    "vision",
    "model-router"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "node --test test/"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md",
    "README.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}
